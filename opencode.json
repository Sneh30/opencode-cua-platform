{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cua-gateway": {
      "type": "local",
      "command": ["uv", "run", "--project", "gateway", "cua-gateway"],
      "cwd": ".",
      "environment": {
        "CUA_GATEWAY_LIVE": "1"
      },
      "timeout": 600000,
      "enabled": true
    },
    "browser-adapter": {
      "type": "local",
      "command": ["uv", "run", "--project", "browser_adapter", "browser-adapter"],
      "cwd": ".",
      "environment": {
        "BROWSER_HEADLESS": "true"
      },
      "timeout": 300000,
      "enabled": true
    }
  }
}